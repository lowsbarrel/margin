{
	"name": "margin",
	"version": "0.1.22",
	"description": "A local-first Markdown note app with end-to-end encrypted S3 sync.",
	"type": "module",
	"engines": {
		"bun": ">=1.3.0"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "bun scripts/prepare.mjs",
		"check": "bun run i18n:compile && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"check:invariants": "bun scripts/check-invariants.mjs",
		"check:secrets": "bun scripts/check-secrets.mjs",
		"i18n:compile": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"tauri": "tauri",
		"gen:bindings": "cd src-tauri && cargo run --bin gen_bindings"
	},
	"trustedDependencies": [
		"esbuild",
		"@tauri-apps/cli"
	],
	"license": "MIT",
	"dependencies": {
		"@codemirror/autocomplete": "^6.20.3",
		"@codemirror/commands": "^6.11.1",
		"@codemirror/lang-markdown": "^6.5.2",
		"@codemirror/language": "^6.12.4",
		"@codemirror/search": "^6.7.2",
		"@codemirror/state": "^6.7.5",
		"@codemirror/view": "^6.43.12",
		"@crabnebula/tauri-plugin-drag": "^2.1.0",
		"@floating-ui/dom": "^1.7.6",
		"@fontsource-variable/inter": "^5.2.8",
		"@fontsource-variable/jetbrains-mono": "^5.2.8",
		"@lezer/common": "^1.5.2",
		"@lezer/highlight": "^1.2.3",
		"@lezer/markdown": "^1.7.2",
		"@lucide/svelte": "^1.27.0",
		"@tauri-apps/api": "^2",
		"@tauri-apps/plugin-dialog": "^2.7.2",
		"@tauri-apps/plugin-opener": "^2",
		"@tauri-apps/plugin-process": "^2.3.1",
		"@tauri-apps/plugin-updater": "~2.11.0",
		"@xterm/addon-fit": "^0.11",
		"@xterm/xterm": "^6",
		"bits-ui": "^2.18.1",
		"clsx": "^2.1.1",
		"html2canvas-pro": "^2.0.4",
		"jspdf": "^4.2.1",
		"katex": "^0.18.7",
		"lowlight": "^3.3.0",
		"markdown-it": "^15.0.2",
		"mermaid": "^11.15.0",
		"pdfjs-dist": "^6.3.289",
		"tailwind-merge": "^3.6.0",
		"tailwind-variants": "^3.3.0",
		"turndown": "^7.2.4",
		"turndown-plugin-gfm": "^1.0.2"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@inlang/paraglide-js": "^2.15.2",
		"@internationalized/date": "^3.12.2",
		"@sveltejs/adapter-static": "^3.0.6",
		"@sveltejs/kit": "^2.9.0",
		"@sveltejs/vite-plugin-svelte": "^5.0.0",
		"@tailwindcss/vite": "^4.3.3",
		"@tauri-apps/cli": "^2",
		"@types/markdown-it": "^14.2.0",
		"@types/node": "^26.6.1",
		"@types/turndown": "^5.0.6",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"prettier": "^3.8.2",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"svelte": "^5.56.8",
		"svelte-check": "^4.0.0",
		"tailwindcss": "^4.3.3",
		"tw-animate-css": "^1.4.0",
		"typescript": "~5.6.3",
		"typescript-eslint": "^8.60.1",
		"vite": "^6.0.3"
	}
}
