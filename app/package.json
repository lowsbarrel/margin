{
	"name": "margin",
	"version": "0.1.22",
	"description": "A local-first Markdown note app with end-to-end encrypted S3 sync.",
	"type": "module",
	"packageManager": "pnpm@10.33.0+sha512.10568bb4a6afb58c9eb3630da90cc9516417abebd3fabbe6739f0ae795728da1491e9db5a544c76ad8eb7570f5c4bb3d6c637b2cb41bfdcdb47fa823c8649319",
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "node scripts/prepare.mjs",
		"check": "pnpm run i18n:compile && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"check:invariants": "node scripts/check-invariants.mjs",
		"check:secrets": "node scripts/check-secrets.mjs",
		"check:deprecated": "eslint --config eslint.config.deprecated.js src",
		"i18n:compile": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"tauri": "tauri",
		"gen:bindings": "cd src-tauri && cargo run --bin gen_bindings"
	},
	"license": "AGPL-3.0-only",
	"dependencies": {
		"@crabnebula/tauri-plugin-drag": "^2.1.0",
		"@floating-ui/dom": "^1.7.6",
		"@fontsource-variable/inter": "^5.2.8",
