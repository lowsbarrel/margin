{
	"version": "0.2.0",
	"configurations": [
		{
			"name": "Tauri: debug Rust",
			"type": "lldb",
			"request": "launch",
			"cargo": {
				"args": [
					"build",
					"--manifest-path=./app/src-tauri/Cargo.toml",
					"--no-default-features",
					"--bin=app"
				]
			},
			"cwd": "${workspaceFolder}/app/src-tauri",
			"preLaunchTask": "bun: dev"
		},
		{
			"name": "Debug current Node script",
			"type": "node",
			"request": "launch",
			"program": "${file}",
			"cwd": "${workspaceFolder}/app",
			"console": "integratedTerminal",
			"skipFiles": ["<node_internals>/**", "**/node_modules/**"]
		}
	]
}
