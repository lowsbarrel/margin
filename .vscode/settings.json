{
	"editor.defaultFormatter": "esbenp.prettier-vscode",
	"editor.formatOnSave": true,
	"editor.codeActionsOnSave": {
		"source.fixAll.eslint": "explicit"
	},
	"[svelte]": {
		"editor.defaultFormatter": "esbenp.prettier-vscode"
	},
	"[rust]": {
		"editor.defaultFormatter": "rust-lang.rust-analyzer"
	},
	"eslint.validate": ["javascript", "typescript", "svelte"],
	"eslint.useFlatConfig": true,
	"eslint.workingDirectories": ["app"],

	// Same TypeScript the CI runs, not VS Code's bundled one.
	"typescript.tsdk": "app/node_modules/typescript/lib",
	"typescript.enablePromptUseWorkspaceTsdk": true,
	"typescript.tsserver.experimental.enableProjectDiagnostics": true,
	"svelte.enable-ts-plugin": true,
	"svelte.plugin.diagnostics.enable": true,

	"rust-analyzer.linkedProjects": ["app/src-tauri/Cargo.toml"],
	"rust-analyzer.checkOnSave": true,
	// Match the CI gate, so the editor flags what the `rust` job would fail on.
	"rust-analyzer.check.command": "clippy",
	"rust-analyzer.check.extraArgs": ["--all-targets", "--", "-D", "warnings"],

	"npm.packageManager": "pnpm",
	"files.exclude": {
		"**/.svelte-kit": true,
		"**/src-tauri/target": true
	},
	"search.exclude": {
		"**/node_modules": true,
		"**/src-tauri/target": true,
		"**/src/lib/paraglide": true
	},
	// Regenerated by `pnpm gen:bindings`; edits would be silently lost.
	"files.readonlyInclude": {
		"app/src/lib/bindings.ts": true
	},
	"files.eol": "\n"
}
