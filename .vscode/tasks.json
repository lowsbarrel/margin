{
	"version": "2.0.0",
	"options": {
		"cwd": "${workspaceFolder}/app"
	},
	"tasks": [
		{
			"label": "bun: dev",
			"type": "shell",
			"command": "bun run dev",
			"isBackground": true,
			"problemMatcher": {
				"owner": "vite",
				"pattern": { "regexp": "^$" },
				"background": { "activeBegins": true, "beginsPattern": "VITE", "endsPattern": "Local" }
			}
		},
		{
			"label": "tauri: dev",
			"type": "shell",
			"command": "bun run tauri dev",
			"isBackground": true,
			"problemMatcher": [],
			"presentation": { "reveal": "always", "panel": "dedicated" }
		},
		{
			"label": "tauri: build",
			"type": "shell",
			"command": "bun run tauri build",
			"group": { "kind": "build", "isDefault": true },
			"problemMatcher": ["$rustc"],
			"presentation": { "reveal": "always", "panel": "dedicated" }
		},
		{
			"label": "bun: check",
			"type": "shell",
			"command": "bun run check",
			"problemMatcher": []
		},
		{
			"label": "bun: lint",
			"type": "shell",
			"command": "bun run lint",
			"problemMatcher": []
		},
		{
			"label": "bun: format",
			"type": "shell",
			"command": "bun run format",
			"problemMatcher": []
		},
		{
			"label": "bun: gen:bindings",
			"type": "shell",
			"command": "bun run gen:bindings",
			"problemMatcher": ["$rustc"]
		},
		{
			"label": "cargo: fmt",
			"type": "shell",
			"command": "cargo fmt",
			"options": { "cwd": "${workspaceFolder}/app/src-tauri" },
			"problemMatcher": []
		},
		{
			"label": "cargo: clippy",
			"type": "shell",
			"command": "cargo clippy --all-targets -- -D warnings",
			"options": { "cwd": "${workspaceFolder}/app/src-tauri" },
			"problemMatcher": ["$rustc"]
		},
		{
			"label": "gate: pre-commit",
			"type": "shell",
			"command": "sh .githooks/pre-commit",
			"options": { "cwd": "${workspaceFolder}" },
			"group": "test",
			"problemMatcher": []
		},
		{
			"label": "gate: full",
			"type": "shell",
			"command": "bun run check:secrets && bun run check:invariants && bun run lint && bun run check && cd src-tauri && cargo fmt --check && cargo clippy --all-targets -- -D warnings && cargo test",
			"group": { "kind": "test", "isDefault": true },
			"problemMatcher": ["$rustc"]
		}
	]
}
