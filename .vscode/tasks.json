{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "dev",
      "type": "shell",
      "command": "mise run dev",
      "problemMatcher": ["$rustc"],
      "presentation": { "reveal": "always", "panel": "dedicated" }
    },
    {
      "label": "fmt",
      "type": "shell",
      "command": "mise run fmt",
      "problemMatcher": []
    },
    {
      "label": "lint",
      "type": "shell",
      "command": "mise run lint",
      "problemMatcher": ["$rustc"]
    },
    {
      "label": "check",
      "type": "shell",
      "command": "mise run check",
      "problemMatcher": []
    },
    {
      "label": "test",
      "type": "shell",
      "command": "mise run test",
      "group": "test",
      "problemMatcher": ["$rustc"]
    },
    {
      "label": "gate",
      "type": "shell",
      "command": "mise run gate",
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": ["$rustc"]
    },
    {
      "label": "bundle",
      "type": "shell",
      "command": "mise run bundle",
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": ["$rustc"]
    }
  ]
}
